# ─── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
APP_URL=http://localhost:8000

# ─── Database ──────────────────────────────────────────────────────────────────
# Default is SQLite (good for development). For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/digest
DATABASE_URL=sqlite:///./digest.db

# ─── NewsAPI ───────────────────────────────────────────────────────────────────
# Get a free key at https://newsapi.org/
NEWS_API_KEY=your_newsapi_key_here

# ─── Anthropic (Claude) ────────────────────────────────────────────────────────
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── SendGrid ──────────────────────────────────────────────────────────────────
# Get your key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=your_sendgrid_api_key_here
FROM_EMAIL=digest@yourdomain.com
FROM_NAME=AI News Digest

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Keys found at https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook secret — generated when you register a webhook endpoint in Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_...
# Price ID of your monthly subscription product (e.g. €9/month)
STRIPE_PRICE_ID=price_...
